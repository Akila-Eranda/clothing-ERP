# Staging environment template. Copy to .env.staging (git-ignored) and fill with FRESH, STAGING-ONLY values.
# NEVER reuse a production value. Generate each secret yourself, e.g.:  openssl rand -hex 24
STG_POSTGRES_USER=hexa_staging
STG_POSTGRES_PASSWORD=<generate: openssl rand -hex 16>
STG_POSTGRES_DB=hexa_staging
STG_REDIS_PASSWORD=<generate: openssl rand -hex 12>
STG_JWT_ACCESS_SECRET=<generate: openssl rand -hex 32>
STG_JWT_REFRESH_SECRET=<generate: openssl rand -hex 32>

# optional overrides (defaults shown)
# STG_POSTGRES_PORT=58431
# STG_REDIS_PORT=58432
# STG_API_A_PORT=58001
# STG_API_B_PORT=58002
# STG_WEB_PORT=58000
# STG_WEB_ORIGIN=http://127.0.0.1:58000
# STG_PUBLIC_API_URL=http://127.0.0.1:58001/api/v1
# STG_DB_POOL=20
