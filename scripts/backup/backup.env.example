# Copy to /etc/hexaone/backup.env on the server (chmod 600, owner root). NEVER commit the real file.
#
#   sudo install -d -m 700 /etc/hexaone
#   sudo install -m 600 scripts/backup/backup.env.example /etc/hexaone/backup.env

# docker = pg_dump inside the PostgreSQL container (production docker-compose setup)
# direct = pg_dump on this host against PGHOST (managed / external PostgreSQL)
BACKUP_MODE=docker
PG_CONTAINER=fashionerp_db

# direct mode only — the password goes in ~/.pgpass (chmod 600), not here:
#   hostname:port:database:username:password
# PGHOST=127.0.0.1
# PGPORT=5433
# PGUSER=fashionerp
# PGDATABASE=fashionerp

BACKUP_DIR=/var/backups/hexaone
BACKUP_RETENTION_DAYS=30

# Strongly recommended: encrypt with a public key whose PRIVATE key is NOT on this server.
# BACKUP_GPG_RECIPIENT=backups@hexalyte.com

# Off-site copy via rclone (configure the remote with `rclone config`; its credentials stay in
# rclone.conf). Use a bucket with object lock / versioning so a compromised host cannot delete history.
# BACKUP_RCLONE_REMOTE=b2-hexaone:hexaone-db-backups
